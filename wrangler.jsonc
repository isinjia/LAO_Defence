// Cloudflare Workers static-asset deploy (Workers Builds runs `npx wrangler deploy` on every push to main).
// The repository root is served as-is; .assetsignore keeps the git history, dev tools and notes out of it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lao-defence",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "."
  }
}
